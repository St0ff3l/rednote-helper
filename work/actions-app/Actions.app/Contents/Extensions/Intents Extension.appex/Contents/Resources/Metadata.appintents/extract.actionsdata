er instances to proceed\n\nIMPORTANT: Ensure the unlocking always happens.\n\nMost common usage: Leave timeout at 0 to cancel immediately if another instance is running.\n\nUse the same lock name across different shortcuts to prevent them from running concurrently.\n\nPerfect for automation shortcuts that might be triggered multiple times quickly.\n\nThis implements a semaphore\/mutex pattern for shortcut synchronization."},"resultValueName":{"alternatives":[],"key":"Lock Acquired"},"searchKeywords":[{"alternatives":[],"key":"lock"},{"alternatives":[],"key":"prevent"},{"alternatives":[],"key":"duplicate"},{"alternatives":[],"key":"concurrent"},{"alternatives":[],"key":"semaphore"},{"alternatives":[],"key":"mutex"},{"alternatives":[],"key":"synchronization"},{"alternatives":[],"key":"running"}]},"effectiveBundleIdentifiers":[],"fullyQualifiedTypeName":"Intents_Extension.ManageShortcutLockIntent","identifier":"ManageShortcutLockIntent","isAuthPolExplicit":false,"isDiscoverable":true,"mangledTypeName":"17Intents_Extension24ManageShortcutLockIntentV","mangledTypeNameByBundleIdentifier":{},"mangledTypeNameByBundleIdentifierV2":{},"mangledTypeNameV2":"17Intents_Extension24ManageShortcutLockIntentV","openAppWhenRun":false,"outputFlags":0,"outputType":{"primitive":{"wrapper":{"typeIdentifier":1}}},"parameters":[{"capabilities":0,"dynamicOptionsSupport":0,"inputConnectionBehavior":0,"isInput":false,"isOptional":false,"name":"lockName","parameterDescription":{"alternatives":[],"key":"Name of the lock to manage. Use the same name across shortcuts to synchronize them."},"resolvableInputTypes":[{"kindValue":0,"valueType":{"primitive":{"wrapper":{"typeIdentifier":0}}}},{"kindValue":0,"valueType":{"array":{"wrapper":{"capabilities":3,"memberValueType":{"primitive":{"wrapper":{"typeIdentifier":2}}}}}}},{"kindValue":0,"valueType":{"primitive":{"wrapper":{"typeIdentifier":2}}}}],"title":{"alternatives":[],"key":"Lock Name"},"typeSpecificMetadata":[],"valueType":{"primitive":{"wrapper