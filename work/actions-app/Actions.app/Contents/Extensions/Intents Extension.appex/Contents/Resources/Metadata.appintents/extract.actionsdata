[{"alternatives":[],"key":"safari"},{"alternatives":[],"key":"chrome"},{"alternatives":[],"key":"firefox"}]},"effectiveBundleIdentifiers":[],"fullyQualifiedTypeName":"Intents_Extension.GetDefaultBrowserIntent","identifier":"GetDefaultBrowserIntent","isAuthPolExplicit":false,"isDiscoverable":true,"mangledTypeName":"17Intents_Extension23GetDefaultBrowserIntentV","mangledTypeNameByBundleIdentifier":{},"mangledTypeNameByBundleIdentifierV2":{},"mangledTypeNameV2":"17Intents_Extension23GetDefaultBrowserIntentV","openAppWhenRun":false,"outputFlags":0,"outputType":{"primitive":{"wrapper":{"typeIdentifier":0}}},"parameters":[],"presentationStyle":0,"requiredCapabilities":[],"supportedModes":1,"systemProtocolMetadata":[],"systemProtocolMetadataV2":[],"systemProtocols":[],"title":{"alternatives":[],"key":"Get Default Browser"},"typeSpecificMetadata":[],"visibilityMetadata":{"assistantOnly":false,"isDiscoverable":true}},"GetDeviceDetailsExtended":{"assistantDefinedSchemaTraits":[],"assistantDefinedSchemas":[],"authenticationPolicy":0,"availabilityAnnotations":{"LNPlatformNameWildcard":{"introducedVersion":"*"}},"descriptionMetadata":{"categoryName":{"title":{"alternatives":[],"key":"Device"}},"descriptionText":{"alternatives":[],"key":"Get details about the device.\n\nIt includes:\n- Uptime (not including sleep)\n- Uptime (including sleep)\n- Active processor count\n- Physical memory\n- Time zone\n- Hostname\n- Thermal state\n- Total storage capacity\n- Available storage capacity\n- Battery condition (macOS-only)\n- Battery health (macOS-only)\n- Serial number (macOS-only)\n\nThis is an extension to the built-in “Get Device Details” action. Unlike the built-in action, this one returns all the values at once instead of making you pick a single value in the action.\n\nTip: You can access the individual values. For example, with the built-in “Show Content” action.\n\nPossible values for thermal state: Nominal, Fair, Serious, Critical\nPossible values for battery condition: Good, Fair, Poor\n\nTip: Use the “Format Duration” action to format the “Uptime” values.\nTip: Use the “Format File Size” action to format the “Physical memory”, “Total storage capacity”, and “Available storage capacity” values."},"resultValueName":{"alternatives":[],"key":"Device Details"},"searchKeywords":[{"alternatives":[],"key":"system"},{"alternatives":[],"key":"info"},{"alternatives":[],"key":"information"},{"alternatives":[],"key":"uptime"},{"alternatives":[],"key":"boot"},{"alternatives":[],"key":"processor"},{"alternatives":[],"key":"cpu"},{"alternatives":[],"key":"memory"},{"alternatives":[],"key":"hostname"},{"alternatives":[],"key":"thermal"},{"alternatives":[],"key":"state"},{"alternatives":[],"key":"temperature"},{"alternatives":[],"key":"heat"},{"alternatives":[],"key":"battery"},{"alternatives":[],"key":"timezone"},{"alternatives":[],"key":"time"},{"alternatives":[],"key":"zone"}]},"effectiveBundleIdentifiers":[],"fullyQualifiedTypeName":"Intents_Extension.GetDeviceDetailsExtended","identifier":"GetDeviceDetailsExtended","isAuthPolExplicit":false,"isDiscoverable":true,"mangledTypeName":"17Intents_Extension24GetDeviceDetailsExtendedV","mangledTypeNameByBundleIdentifier":{},"mangledTypeNameByBundleIdentifierV2":{},"mangledTypeNameV2":"17Intents_Extension24GetDeviceDetailsExtendedV","openAppWhenRun":false,"outputFlags":0,"outputType":{"entity":{"wrapper":{"typeName":"DeviceDetailsAppEntity"}}},"parameters":[],"presentationStyle":0,"requiredCapabilities":[],"supportedModes":1,"systemProtocolMetadata":[],"systemProtocolMetadataV2":[],"systemProtocols":[],"title":{"alternatives":[],"key":"Get Device Details (Extended)"},"typeSpecificMetadata":[],"visibilityMetadata":{"assistantOnly":false,"isDiscoverable":true}},"GetDeviceMotionActivityIntent":{"assistantDefinedSchemaTraits":[],"assistantDefinedSchemas":[],"authenticationPolicy":0,"availabilityAnnotations":{"LNPlatformNameWildcard":{"introducedVersion":"*"}},"descriptionMetadata":{"categoryName":{"title":{"alternatives":[],"key":"Device"}},"descriptionText":{"alternatives":[],"key":"Returns the current motion activity of the device (stationary, walking, running, cycling, automotive, etc.).\n\nMultiple activities can be true at once. For example, when a car stops at a red light, both “stationary” and “automotive” will be true. All activities can also be false when the motion doesn't match any known pattern.\n\nThe confidence level can be: Low, Medium, High\n\nTip: Use the built-in “Show Content” action to inspect the individual properties.\n\nNOTE: On macOS and visionOS, it's always “Unknown: true”."},"resultValueName":{"alternatives":[],"key":"Motion Activity"},"searchKeywords":[{"alternatives":[],"key":"movement"},{"alternatives":[],"key":"moving"},{"alternatives":[],"key":"walking"},{"alternatives":[],"key":"running"},{"alternatives":[],"key":"driving"},{"alternatives":[],"key":"car"},{"alternatives":[],"key":"bicycle"},{"alternatives":[],"key":"stationary"},{"alternatives":[],"key":"sensor"}]},"effectiveBundleIdentifiers":[],"fullyQualifiedTypeName":"Intents_Extension.GetDeviceMotionActivityIntent","identifier":"GetDeviceMotionActivityIntent","isAuthPolExplicit":false,"isDiscoverable":true,"mangledTypeName":"17Intents_Extension29GetDeviceMotionActivityIntentV","mangledTypeNameByBundleIdentifier":{},"mangledTypeNameByBundleIdentifierV2":{},"mangledTypeNameV2":"17Intents_Extension29GetDeviceMotionActivityIntentV","openAppWhenRun":false,"outputFlags":0,"outputType":{"entity":{"wrapper":{"typeName":"DeviceMotionActivityAppEntity"}}},"parameters":[],"presentationStyle":0,"requiredCapabilities":[],"supportedModes":1,"systemProtocolMetadata":[],"systemProtocolMetadataV2":[],"systemProtocols":[],"title":{"alternatives":[],"key":"Get Device Motion Activity"},"typeSpecificMetadata":[],"visibilityMetadata":{"assistantOnly":false,"isDiscoverable":true}},"GetDeviceMotionData":{"actionConfiguration":{"actionSummary":{"wrapper":{"otherParameterIdentifiers":["sampleCount","interval"],"summaryString":{"formatString":"Get device motion data","parameterIdentifiers":[]}}}},"assistantDefinedSchemaTraits":[],"assistantDefinedSchemas":[],"authenticationPolicy":0,"availabilityAnnotations":{"LNPlatformNameMACOS":{"obsoletedVersion":"*"},"LNPlatformNameVISIONOS":{"obsoletedVersion":"*"},"LNPlatformNameWildcard":{"introducedVersion":"*"}},"descriptionMetadata":{"categoryName":{"title":{"alternatives":[],"key":"Device"}},"descriptionText":{"alternatives":[],"key":"Returns measurements of the acceleration, rotation rate, and attitude of the device.\n\nData:\n- User Acceleration: Acceleration that the user is giving to the device.\n- Gravity: Gravity acceleration vector expressed in the device's reference frame.\n- Rotation Rate: Bias-corrected gyroscope data measuring rotation around three axes.\n- Attitude: Orientation of the device relative to the device's reference frame.\n\t- Roll: Rotation around a longitudinal axis that passes through the device from its top to bottom.\n\t- Pitch: Rotation around a lateral axis that passes through the device from side to side.\n\t- Yaw: Rotation around its vertical axis, originating at its center of gravity and directed downwards.\n\t- Quaternion: Orientation in 3D space as a quaternion, providing a compact and efficient way to describe its rotation relative to the device's reference frame.\n\n[More info about this data.](https:\/\/developer.apple.com\/documentation\/coremotion\/cmdevicemotion)\n\nTip: Use the built-in “Show Content” action to inspect the individual properties.\n\nNOTE: On iOS, the action can only run for a maximum of 30 seconds, so the interval times sample count must be less than that.\n\nNOTE: Does not work on visionOS."},"resultValueName":{"alternatives":[],"key":"Device Motion Data"},"searchKeywords":[{"alternatives":[],"key":"motion"},{"alternatives":[],"key":"movement"},{"alternatives":[],"key":"accelerometer"},{"alternatives":[],"key":"gyro"},{"alternatives":[],"key":"attitude"},{"alternatives":